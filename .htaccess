# SleekAI — clean URLs and access rules.
#
# Pages are served without their extension: /login runs login.php. Links anywhere
# on the site should use the extension-less form. Paths are relative throughout,
# so this works both at http://localhost/sleekai.com.ng/ and at a domain root.

# No directory listings, and no content negotiation guessing at extensions —
# the rewrite below does that job explicitly.
Options -Indexes -MultiViews

# The home page is PHP (it renders the live pack prices).
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Composer dependencies and their manifests are never public.
    RewriteRule ^vendor(/|$) - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # /index.html (or /index) → / — the home page has exactly one address.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)?/index(\.html|\.php)?[?\s]
    RewriteRule ^ %1/ [R=301,L,NE]

    # Old-style /login.php or /pricing.html → permanent redirect to /login or
    # /pricing, so bookmarks keep working and no extension shows in the address bar.
    # GET/HEAD only: redirecting a POST would make the browser drop the form body.
    # cdn-cgi/ is Cloudflare's own email-protection page; left exactly as is.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_URI} !/cdn-cgi/
    RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)\.(php|html)[?\s]
    RewriteRule ^ %1 [R=301,L,NE]

    # /login → login.php, /pricing → pricing.html, when that file exists.
    # Directories are left alone.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
